  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.33.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.23"
