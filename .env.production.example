# Copy to .env.production. Keep this file out of Git and restrict its permissions.
# The credential and session key files must be readable only by deployment operators.
MAYDAY_APPLICATION_CREDENTIALS_HOST_FILE=./secrets/application-credentials.json
MAYDAY_SESSION_SECRET_HOST_FILE=./secrets/session-signing-key
MAYDAY_DATABASE_PATH=/var/lib/mayday-dispatch/mayday-dispatch.sqlite

# Set only after the canonical HTTPS domain has been selected and routed.
MAYDAY_PUBLIC_BASE_URL=
# Explicit browser origin used for same-origin editorial mutation checks.
MAYDAY_EDITORIAL_ORIGIN=https://thegoldenhorn.news
MAYDAY_PUBLIC_INDEXING_DISABLED=false

# Dev identity headers are never valid in production.
MAYDAY_TRUST_DEV_HEADERS=false
